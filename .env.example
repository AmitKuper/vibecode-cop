# ── Network ───────────────────────────────────────────────────────────────────
# Port this agent listens on (overrides cop/config.toml local_port)
LOCAL_PORT=61224

# Opponent's public URL (overrides cop/config.toml peer_url)
# Set this to your opponent's thief endpoint before a real match
PEER_URL=http://localhost:61223

# ── Crypto ────────────────────────────────────────────────────────────────────
# Shared HMAC secret agreed with opponent (overrides config.toml crypto.shared_secret)
SHARED_SECRET=dev-secret-change-me

# ── LLM ───────────────────────────────────────────────────────────────────────
# Required when using Anthropic provider (set in cop/config.toml: provider = "anthropic")
ANTHROPIC_API_KEY=sk-ant-...

# Required when using OpenAI provider
OPENAI_API_KEY=sk-...

# Ollama base URL (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# ── Gmail reporting ───────────────────────────────────────────────────────────
# Leave blank to use paths from cop/config.toml [reports.gmail]
GMAIL_CREDENTIALS_FILE=secrets/gmail/credentials.json
GMAIL_TOKEN_FILE=secrets/gmail/token.json
